<Window x:Class="AnkietaWPF.WiekKolorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ankieta - etap 2"
        Height="320" Width="350"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Etap 2: Wiek i kolor"
                   FontSize="20"
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <TextBlock Text="Podaj wiek:"/>
        <TextBox x:Name="WiekTextBox"
                 Height="30"
                 Margin="0,5,0,15"/>

        <TextBlock Text="Wybierz ulubiony kolor:"/>
        <ComboBox x:Name="KolorComboBox"
                  Height="30"
                  Margin="0,5,0,15">
            <ComboBoxItem Content="Czerwony"/>
            <ComboBoxItem Content="Niebieski"/>
            <ComboBoxItem Content="Zielony"/>
            <ComboBoxItem Content="Żółty"/>
            <ComboBoxItem Content="Czarny"/>
            <ComboBoxItem Content="Biały"/>
        </ComboBox>

        <Button Content="Dalej"
                Height="35"
                Click="Dalej_Click"/>
    </StackPanel>
</Window>