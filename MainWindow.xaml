<Window x:Class="AnkietaWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ankieta - etap 1"
        Height="250" Width="350"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Etap 1: Wybierz płeć"
                   FontSize="20"
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <RadioButton x:Name="KobietaRadio"
                     Content="K"
                     GroupName="Plec"
                     Margin="0,5"/>

        <RadioButton x:Name="MezczyznaRadio"
                     Content="M"
                     GroupName="Plec"
                     Margin="0,5"/>

        <Button Content="Dalej"
                Margin="0,20,0,0"
                Height="35"
                Click="Dalej_Click"/>
    </StackPanel>
</Window>